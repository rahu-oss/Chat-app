<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write new chat</title>

    <style>
        body {
            font-family: "Segoe UI", Arial, sans-serif;
            background: #eef3fb;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
        }

        .form-container {
            background: rgba(255, 255, 255, 0.75);
            padding: 30px 35px;
            border-radius: 20px;
            width: 350px;
            box-shadow: 0 4px 25px rgba(0,0,0,0.1);
            backdrop-filter: blur(10px);
            animation: fadeIn 0.5s ease;
        }

        h3 {
            text-align: center;
            font-size: 24px;
            margin-bottom: 20px;
            color: #1e293b;
        }

        input, textarea {
            width: 100%;
            padding: 12px;
            border-radius: 10px;
            border: 1px solid #cbd5e1;
            margin-bottom: 15px;
            font-size: 15px;
            outline: none;
            transition: 0.2s;
        }

        input:focus, textarea:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 4px rgba(59, 130, 246, 0.4);
        }

        textarea {
            height: 120px;
            resize: vertical;
        }

        button {
            width: 100%;
            background: #3b82f6;
            color: white;
            border: none;
            padding: 12px;
            border-radius: 10px;
            font-size: 16px;
            cursor: pointer;
            font-weight: 600;
            transition: 0.2s;
        }

        button:hover {
            background: #2563eb;
        }

        /* fade animation */
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>

</head>
<body>

    <div class="form-container">
        <h3>Write a new Chat ✨</h3>

        <form method="post" action="/chats">
            <input placeholder="Who are you?" name="from" required>

            <textarea name="msg" placeholder="Write your message here..." required></textarea>

            <input placeholder="Add receiver" name="to" required>

            <button>Create Chat</button>
        </form>
    </div>

</body>
</html>
